<?xml version="1.0" encoding="UTF-8"?>
<!-- T006 — structured JSON logs (constitution Observability).
     MDC carries correlationId, notificationId, deliveryId. Never log the content
     payload or an unmasked recipient reference (Principle V). -->
<configuration>
    <springProfile name="!plain">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>correlationId</includeMdcKeyName>
                <includeMdcKeyName>notificationId</includeMdcKeyName>
                <includeMdcKeyName>deliveryId</includeMdcKeyName>
                <includeMdcKeyName>channel</includeMdcKeyName>
                <includeMdcKeyName>attemptNumber</includeMdcKeyName>
                <includeMdcKeyName>failureClassification</includeMdcKeyName>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>

    <springProfile name="plain">
        <appender name="PLAIN" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="PLAIN"/>
        </root>
    </springProfile>
</configuration>
